{
  "name": "public-license-selector-plugin",
  "version": "0.3.0",
  "description": "DSW Plugin for selecting a public license in integration questions",
  "license": "MIT",
  "author": "Marek Suchánek <marek.suchanek@cvut.cz>",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run typecheck && npm run lint && npm run build:prod",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "dev": "concurrently -k \"npm run build:watch\" \"npm run serve:dist\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" && eslint src --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint src",
    "serve:dist": "vite preview --strictPort --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@ds-wizard/plugin-sdk": "^0.12.0",
    "@ufal/license-selector": "^0.2.0",
    "jquery": "^4.0.0",
    "lodash": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
